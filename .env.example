NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://neondb_owner:"
JWT_SECRET=       # Generate a secure random string for JWT secret - openssl rand -base64 or -hex 64
JWT_EXPIRES=3600s # e.g., 3600s for 1 hour

APP_URL=http://localhost:3000 # Your backend URL

MAIL_HOST=
MAIL_PASS=
MAIL_USER=
MAIL_PORT=
MAIL_FROM=
MAIL_SECURE=

COOKIE_DOMAIN=                             # Optional: Set your domain for production (e.g., .yourdomain.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000 # Comma-separated list of allowed origins for CORS

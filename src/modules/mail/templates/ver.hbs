<html lang='it'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Conferma registrazione</title>
    <style>
      body {
        background-color: #f6f6f6;
        margin: 0;
        padding: 0;
        font-family: Arial, Helvetica, sans-serif;
      }
      .container {
        max-width: 480px;
        margin: 40px auto;
        background: #ffffff;
        padding: 30px 25px;
        border-radius: 12px;
        border: 1px solid #e5e5e5;
      }
      .logo {
        text-align: center;
        margin-bottom: 20px;
      }
      .title {
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 15px;
        color: #333;
        text-align: center;
      }
      .text {
        font-size: 15px;
        line-height: 1.6;
        color: #555;
        margin-bottom: 20px;
      }
      .token-box {
        background: #f0f7ff;
        border-left: 4px solid #2f80ed;
        padding: 12px 15px;
        font-size: 18px;
        font-weight: bold;
        text-align: center;
        letter-spacing: 1px;
        color: #2f80ed;
        margin-bottom: 25px;
      }
      .btn {
        display: inline-block;
        padding: 12px 20px;
        background-color: #2f80ed;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: bold;
        margin: 0 auto;
        text-align: center;
      }
      .footer {
        text-align: center;
        margin-top: 25px;
        font-size: 12px;
        color: #999;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <div class='logo'>
        <img src='https://i.imgur.com/ysCR4Rg.png' width='70' alt='logo' />
      </div>

      <div class='title'>Benvenuto!</div>

      <p class='text'>
        Grazie per esserti registrato. Per completare la verifica dell’account
        puoi usare il codice qui sotto:
      </p>

      <div class='token-box'>
        {{token}}
      </div>

      <p class='text' style='text-align: center;'>
        Oppure puoi confermare rapidamente tramite il pulsante:
      </p>

      <div style='text-align: center; margin-bottom: 20px;'>
        <a class='btn' href='{{verifyUrl}}'>Conferma registrazione</a>
      </div>

      <div class='footer'>
        Se non hai richiesto questo account, puoi ignorare questa email.
      </div>
    </div>
  </body>
</html>
